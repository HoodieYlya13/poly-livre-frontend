# ==============================================================================
# Frontend environment — production (Vercel) reference.
# Add these in Vercel → Project → Settings → Environment Variables (Production).
# NEXT_PUBLIC_* values are exposed to the browser; the rest stay server-only.
# ==============================================================================

# --- Backend wiring -----------------------------------------------------------
# Server-side calls (server actions / RSC) → your Hugging Face Space URL.
BACKEND_URL=https://your-user-your-space.hf.space
# Browser-side usage (book cover <img> src). Must be the same public HTTPS URL.
NEXT_PUBLIC_BACKEND_URL=https://your-user-your-space.hf.space

# --- App behaviour ------------------------------------------------------------
# "true" keeps the /auth-testing-mode password gate in front of the whole app.
NEXT_PUBLIC_TESTING_MODE=true
NEXT_PUBLIC_APP_NAME=Liprerie
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Rate limiting (Upstash Redis) --------------------------------------------
# Required in production; without it server actions throw on first call.
# Upstash console → your database → REST API.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
